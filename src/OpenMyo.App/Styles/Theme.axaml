<!-- Colour tokens. Every colour in the app comes from here (CODESTANDARDS §8). -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Discord / GitKraken-inspired: dark-first, layered surfaces from darkest (rail) to lightest (cards). -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="RailBrush" Color="#1E1F22" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#232428" />
      <SolidColorBrush x:Key="ListPaneBrush" Color="#2B2D31" />
      <SolidColorBrush x:Key="ContentBrush" Color="#313338" />
      <SolidColorBrush x:Key="CardBrush" Color="#383A40" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#3F4147" />
      <SolidColorBrush x:Key="InputBrush" Color="#1E1F22" />
      <SolidColorBrush x:Key="SeparatorBrush" Color="#1A1B1E" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#DBDEE1" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#949BA4" />
      <SolidColorBrush x:Key="HoverBrush" Color="#35373C" />
      <SolidColorBrush x:Key="EditScrimBrush" Color="#B3404249" />
      <SolidColorBrush x:Key="DialogScrimBrush" Color="#99000000" />
      <SolidColorBrush x:Key="ChipBorderBrush" Color="#4E5058" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#335865F2" />
      <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#805865F2" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#C9CDFB" />
      <SolidColorBrush x:Key="SelectedBrush" Color="#404249" />
      <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#4E5058" />
      <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#6D6F78" />
      <SolidColorBrush x:Key="PlaceholderBrush" Color="#1E1F22" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F0B232" />
      <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#33F0B232" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F23F43" />
      <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#33F23F43" />
      <!-- Fluent text box colours -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#1E1F22" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1E1F22" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1E1F22" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5865F2" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#DBDEE1" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#DBDEE1" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#DBDEE1" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6D6F78" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6D6F78" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6D6F78" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="RailBrush" Color="#E3E5E8" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#F2F3F5" />
      <SolidColorBrush x:Key="ListPaneBrush" Color="#F2F3F5" />
      <SolidColorBrush x:Key="ContentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardBrush" Color="#F2F3F5" />
      <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E5E8" />
      <SolidColorBrush x:Key="InputBrush" Color="#E3E5E8" />
      <SolidColorBrush x:Key="SeparatorBrush" Color="#E1E2E4" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#313338" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C5E66" />
      <SolidColorBrush x:Key="HoverBrush" Color="#E8E9EB" />
      <SolidColorBrush x:Key="EditScrimBrush" Color="#B3D7D9DC" />
      <SolidColorBrush x:Key="DialogScrimBrush" Color="#66000000" />
      <SolidColorBrush x:Key="ChipBorderBrush" Color="#C4C9CE" />
      <SolidColorBrush x:Key="AccentSubtleBrush" Color="#225865F2" />
      <SolidColorBrush x:Key="AccentSubtleBorderBrush" Color="#665865F2" />
      <SolidColorBrush x:Key="AccentTextBrush" Color="#3C45A5" />
      <SolidColorBrush x:Key="SelectedBrush" Color="#D7D9DC" />
      <SolidColorBrush x:Key="SecondaryButtonBrush" Color="#E3E5E8" />
      <SolidColorBrush x:Key="SecondaryButtonHoverBrush" Color="#D1D3D7" />
      <SolidColorBrush x:Key="PlaceholderBrush" Color="#E3E5E8" />
      <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
      <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#33F0B232" />
      <SolidColorBrush x:Key="DangerBrush" Color="#DA373C" />
      <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#26F23F43" />
      <!-- Fluent text box colours -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#E3E5E8" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E3E5E8" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E3E5E8" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5865F2" />
      <SolidColorBrush x:Key="TextControlForeground" Color="#313338" />
      <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#313338" />
      <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#313338" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80848E" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80848E" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80848E" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Accent ("blurple"). Fluent derives buttons, toggles, focus rings and progress bars from these. -->
  <Color x:Key="SystemAccentColor">#5865F2</Color>
  <Color x:Key="SystemAccentColorLight1">#6D78F4</Color>
  <Color x:Key="SystemAccentColorLight2">#828CF6</Color>
  <Color x:Key="SystemAccentColorLight3">#98A0F8</Color>
  <Color x:Key="SystemAccentColorDark1">#4752C4</Color>
  <Color x:Key="SystemAccentColorDark2">#3C45A5</Color>
  <Color x:Key="SystemAccentColorDark3">#2F3785</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="#5865F2" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

  <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="PillCornerRadius">10</CornerRadius>

  <!-- 24x24 glyphs, SF Symbols / Segoe Fluent style line icons. -->
  <StreamGeometry x:Key="IconLibrary">M9 3v10.55A4 4 0 1 0 11 17V7h6V3H9z</StreamGeometry>
  <StreamGeometry x:Key="IconEmpty">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 2a8 8 0 0 1 6.32 12.9L7.1 5.68A7.96 7.96 0 0 1 12 4zM5.68 7.1 16.9 18.32A8 8 0 0 1 5.68 7.1z</StreamGeometry>
  <StreamGeometry x:Key="IconPicture">M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2v8.6l4-4 3 3 2-2 4 4V7H5zm10 1.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
  <StreamGeometry x:Key="IconCover">M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zm0 2v14h14V5H5z</StreamGeometry>
  <StreamGeometry x:Key="IconImport">M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10zM12.5 9.5h4v1.6h-2.5V15.5a2 2 0 1 1-1.5-1.94z</StreamGeometry>
  <StreamGeometry x:Key="IconSettings">M3 6h10v2H3V6zm14 0h4v2h-4V6zm-2-2h2v6h-2V4zM3 16h4v2H3v-2zm8 0h10v2H11v-2zm-2-2h2v6H9v-6z</StreamGeometry>
  <StreamGeometry x:Key="IconGrip">M9 5h2v2H9zm4 0h2v2h-2zM9 11h2v2H9zm4 0h2v2h-2zM9 17h2v2H9zm4 0h2v2h-2z</StreamGeometry>
  <StreamGeometry x:Key="IconAdd">M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z</StreamGeometry>
  <StreamGeometry x:Key="IconTitles">M4 6h16v2H4zm0 5h16v2H4zm0 5h10v2H4z</StreamGeometry>
  <StreamGeometry x:Key="IconSort">M7 4l4 4H8v12H6V8H3zm10 16l-4-4h3V4h2v12h3z</StreamGeometry>
  <StreamGeometry x:Key="IconGrid">M4 4h7v7H4zm9 0h7v7h-7zM4 13h7v7H4zm9 0h7v7h-7z</StreamGeometry>
  <StreamGeometry x:Key="IconList">M4 5h4v4H4zm6 1h10v2H10zM4 10h4v4H4zm6 1h10v2H10zM4 15h4v4H4zm6 1h10v2H10z</StreamGeometry>
  <StreamGeometry x:Key="IconMore">M6 10.5a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm6 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm6 0a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3z</StreamGeometry>
  <StreamGeometry x:Key="IconUp">M7.41 15.41 12 10.83l4.59 4.58L18 14l-6-6-6 6z</StreamGeometry>
  <StreamGeometry x:Key="IconDown">M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z</StreamGeometry>
  <StreamGeometry x:Key="IconRemove">M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4z</StreamGeometry>
  <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.96 7.96 0 0 0 12 4a8 8 0 1 0 7.73 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
  <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
  <StreamGeometry x:Key="IconPause">M6 5h4v14H6zm8 0h4v14h-4z</StreamGeometry>
  <StreamGeometry x:Key="IconNext">M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z</StreamGeometry>
  <StreamGeometry x:Key="IconPrevious">M6 6h2v12H6zm3.5 6 8.5 6V6z</StreamGeometry>
  <StreamGeometry x:Key="IconVolume">M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02z</StreamGeometry>
  <StreamGeometry x:Key="IconNowPlaying">M5 10h3v9H5zm5.5-5h3v14h-3zM16 13h3v6h-3z</StreamGeometry>
  <!-- Output (where audio plays): a speaker. Deliberately not the AirPlay symbol, which is reserved for Apple's own controls. -->
  <StreamGeometry x:Key="IconOutput">M17 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zm-5 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4zm0 16a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z</StreamGeometry>
  <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
  <StreamGeometry x:Key="IconSparkle">M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z</StreamGeometry>
</ResourceDictionary>
