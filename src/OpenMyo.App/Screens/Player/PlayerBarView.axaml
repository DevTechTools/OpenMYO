<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenMyo.App.Screens.Player"
             x:Class="OpenMyo.App.Screens.Player.PlayerBarView"
             x:DataType="vm:PlayerBarViewModel">
  <!-- The bar under every page: local or Yoto-player controls, then the output button in the lower-right corner,
       where people look for "where is this playing?" (as with speaker pickers on phones and computers). -->
  <Border Classes="nowPlaying">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6"
            IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="secondary" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Notice}" />
        <Button Grid.Column="1" Classes="subtle" Content="Dismiss" Command="{Binding DismissNoticeCommand}" />
      </Grid>
      <vm:LivePlayersView DockPanel.Dock="Top" Margin="0,0,0,6" DataContext="{Binding Live}" />
      <vm:OutputPickerView DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" DataContext="{Binding Output}" />
      <Panel>
        <vm:NowPlayingView DataContext="{Binding Local}" IsVisible="{Binding $parent[vm:PlayerBarView].((vm:PlayerBarViewModel)DataContext).ShowLocal}" />
        <vm:RemotePlaybackView DataContext="{Binding Remote}" IsVisible="{Binding $parent[vm:PlayerBarView].((vm:PlayerBarViewModel)DataContext).IsRemote}" />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
