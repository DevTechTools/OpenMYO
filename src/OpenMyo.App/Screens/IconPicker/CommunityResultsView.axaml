<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:OpenMyo.App.Controls"
             xmlns:vm="using:OpenMyo.App.Screens.IconPicker"
             x:Class="OpenMyo.App.Screens.IconPicker.CommunityResultsView"
             x:DataType="vm:CommunityResultsViewModel">
  <!-- Community icons: credited to their artists; choosing one adds it to your Yoto icons. -->
  <StackPanel Spacing="6">
    <Grid ColumnDefinitions="*,Auto" Margin="2,6,2,0">
      <TextBlock Classes="sectionHeader" Margin="0" Text="COMMUNITY · YOTOICONS.COM" />
      <ProgressBar Grid.Column="1" Width="40" MinWidth="0" VerticalAlignment="Center" IsIndeterminate="True" IsVisible="{Binding IsSearching}" />
    </Grid>
    <TextBlock Classes="secondary" Margin="2,0" TextWrapping="Wrap" Text="{Binding Status}"
               IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <ItemsControl ItemsSource="{Binding Results}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:CommunityTileViewModel">
          <Button Classes="iconTile" Command="{Binding ChooseCommand}"
                  ToolTip.Tip="{Binding ToolTip}" AutomationProperties.Name="{Binding Icon.Title}">
            <Panel>
              <controls:PixelImage Source="{Binding Image}" Width="32" Height="32" />
              <ProgressBar IsIndeterminate="True" VerticalAlignment="Bottom" MinWidth="0" Width="32" Height="3"
                           IsVisible="{Binding IsImporting}" />
            </Panel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
